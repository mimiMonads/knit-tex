{
  "name": "knit-tex",
  "version": "0.1.0",
  "description": "A tiny TeX-flavoured typesetter: Knuth-Plass paragraphs and PDF pages set on a knitting worker pool.",
  "type": "module",
  "bin": {
    "knit-tex": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@pdf-lib/standard-fonts": "^1.0.0",
    "hyphen": "^1.14.1",
    "knitting": "npm:@jsr/vixeny__knitting@0.1.73"
  },
  "devDependencies": {
    "piscina": "^5.3.2"
  },
  "scripts": {
    "demo": "node src/cli.mjs examples/demo.tex --check",
    "novel": "node scripts/gutenberg.mjs && node src/cli.mjs examples/pride-and-prejudice.tex --check",
    "bench": "node scripts/gutenberg.mjs && node scripts/bench.mjs",
    "bench:sawyer": "node scripts/gutenberg-tom-sawyer.mjs && node scripts/bench.mjs examples/tom-sawyer.tex",
    "bench:mixed": "node scripts/gutenberg.mjs && node scripts/gutenberg-tom-sawyer.mjs && node scripts/bench-mixed.mjs"
  },
  "files": [
    "src",
    "scripts",
    "examples/*.tex",
    "README.md"
  ]
}
